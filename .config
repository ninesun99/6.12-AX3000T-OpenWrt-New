# ============================================================
# 小米 AX3000T V1 / 6.12 源码 / stock 分区
# 说明：以 # 开头的是注释（不会生效），不带 # 的才会生效
# ============================================================

# ---------- 1. 硬件锁定（这 3 行千万别动）----------
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_xiaomi_mi-router-ax3000t=y

# ---------- 2. 闭源 WiFi 驱动（6.12 必须写，不然 WiFi 起不来）----------
CONFIG_PACKAGE_kmod-mt_wifi=y
CONFIG_PACKAGE_kmod-conninfra=y
CONFIG_PACKAGE_kmod-warp=y
CONFIG_PACKAGE_mtwifi-cfg-ucode=y
CONFIG_PACKAGE_luci-app-mtwifi-cfg=y
CONFIG_PACKAGE_luci-app-turboacc-mtk=y

# ---------- 3. 补回 6.12 被砍掉的实用包 ----------
# USB 支持（AX3000T 有 USB 口，插 U盘/硬盘/网卡要用）
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_automount=y
# 网页终端（在浏览器里敲命令行）
CONFIG_PACKAGE_luci-app-ttyd=y

# ---------- 4. 你的个人定制（原来就有的，保留）----------
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_dnsmasq=n
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-smartdns=y
CONFIG_PACKAGE_luci-i18n-smartdns-zh-cn=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-app-ramfree=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

# ---------- 5. DDNS 动态域名（你工作流里本来就克隆了它，想用就留着）----------


# ---------- 6. 可选功能（默认关闭；想用就把那一行开头的 # 删掉，再编译）----------
# WireGuard 组网/连回家里（一般用不到）
# CONFIG_PACKAGE_kmod-wireguard=y
# CONFIG_PACKAGE_luci-app-wireguard=y

Full Cone NAT（玩主机游戏联机/PT 下载提升 NAT 类型才用；6.12 必须用 nft 版）
CONFIG_PACKAGE_kmod-nft-fullcone=y

# NTFS 格式的 U 盘（你的 U 盘是 NTFS 才开）
# CONFIG_PACKAGE_kmod-fs-ntfs3=y
# ZRAM 换 zstd 压缩（256MB 小内存更省，但更费 CPU）
# CONFIG_PACKAGE_kmod-lib-zstd=y
# 生成 initramfs 临时系统（想用"先试用再刷"的更稳刷机法才开）
# CONFIG_TARGET_ROOTFS_INITRAMFS=y
